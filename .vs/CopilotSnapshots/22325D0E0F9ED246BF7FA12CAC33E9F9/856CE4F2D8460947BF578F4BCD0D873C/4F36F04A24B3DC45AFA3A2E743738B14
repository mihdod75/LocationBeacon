#endif

    private ValidationResult ValidatePairingKey(string pairingKey)
    {
        if (string.IsNullOrWhiteSpace(pairingKey))
            return ValidationResult.Failure("Pairing key not configured");

        if (pairingKey.Length < MinPairingKeyLength)
            return ValidationResult.Failure($"Pairing key too short (min {MinPairingKeyLength} chars)");

        if (pairingKey.Length > MaxPairingKeyLength)
            return ValidationResult.Failure($"Pairing key too long (max {MaxPairingKeyLength} chars)");

        return ValidationResult.Success();
    }

    private ValidationResult ValidateCoordinates(double latitude, double longitude)
    {
        if (latitude < MinLatitude || latitude > MaxLatitude)
            return ValidationResult.Failure($"Invalid latitude: {latitude} (must be between {MinLatitude} and {MaxLatitude})");

        if (longitude < MinLongitude || longitude > MaxLongitude)
            return ValidationResult.Failure($"Invalid longitude: {longitude} (must be between {MinLongitude} and {MaxLongitude})");

        if (latitude == 0 && longitude == 0)
            return ValidationResult.Failure("Could not obtain valid location");

        return ValidationResult.Success();
    }

    private ValidationResult ValidateBatteryLevel(int battery)
    {
        if (battery < MinBatteryLevel || battery > MaxBatteryLevel)
            return ValidationResult.Failure($"Invalid battery level: {battery}%");

        return ValidationResult.Success();
    }

    private ValidationResult ValidateAccuracy(double accuracy)
    {
        if (accuracy < MinAccuracy)
            return ValidationResult.Failure($"Invalid accuracy: {accuracy}m");

        return ValidationResult.Success();
    }

    private ValidationResult ValidateTimestamp(DateTime recordedAt)
    {
        var now = DateTime.UtcNow;
        var timeDiff = now - recordedAt;

        if (timeDiff.TotalMinutes > MaxTimeOffsetPastMinutes)
            return ValidationResult.Failure($"Timestamp too old: {timeDiff.TotalMinutes:F1} minutes ago");

        if (timeDiff.TotalMinutes < -MaxTimeOffsetFutureMinutes)
            return ValidationResult.Failure($"Timestamp in future: {Math.Abs(timeDiff.TotalMinutes):F1} minutes ahead");

        return ValidationResult.Success();
    }

#if __ANDROID__
    private void ShowToastNotification(string message)
    {
        try
        {
            var context = Android.App.Application.Context;
            var handler = new Android.OS.Handler(Android.OS.Looper.MainLooper);
            handler.Post(() =>
            {
                Android.Widget.Toast.MakeText(context, message, Android.Widget.ToastLength.Long)?.Show();
            });
        }
        catch (Exception ex)
        {
            DebugWriter.WriteLine($"✗ Failed to show toast: {ex.Message}");
        }
    }
#endif

    /// <summary>
    /// Calculates distance between two geographic coordinates using the Haversine formula.
    /// </summary>
    /// <returns>Distance in meters</returns>
    private double CalculateHaversineDistance(double lat1, double lon1, double lat2, double lon2)
    {
        const double earthRadiusMeters = 6371000; // Earth's radius in meters

        double dLat = (lat2 - lat1) * Math.PI / 180;
        double dLon = (lon2 - lon1) * Math.PI / 180;
        double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                   Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) *
                   Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
        double distance = earthRadiusMeters * c;

        return distance;
    }

    /// <summary>
    /// Checks if current position is too close to last known position (within 10x10 meter area).
    /// Returns true if position is considered a duplicate (within the threshold).
    /// </summary>
    private bool IsPositionDuplicate(double latitude, double longitude)
    {
        // First position is never a duplicate
        if (_lastLatitude == 0 && _lastLongitude == 0)
        {
            return false;
        }

        // Check if it's been more than 2 minutes since last position was recorded
        // If so, send a keepalive beacon even if position hasn't changed
        if ((DateTime.UtcNow - _lastPositionTime).TotalSeconds >= PositionKeepaliveSeconds)
        {
            DebugWriter.WriteLine($"⏱ Position keepalive: 2+ minutes elapsed, sending beacon");
            return false; // Not a duplicate - send keepalive
        }

        double distanceMeters = CalculateHaversineDistance(_lastLatitude, _lastLongitude, latitude, longitude);
        bool isDuplicate = distanceMeters < PositionDeduplicationRadiusMeters;

        if (isDuplicate)
        {
            DebugWriter.WriteLine($"⊘ Position duplicate: {distanceMeters:F1}m from last (threshold: {PositionDeduplicationRadiusMeters}m)");
        }

        return isDuplicate;
    }

    private class ValidationResult
    {
        public bool IsValid { get; set; }
        public string Message { get; set; } = string.Empty;

        public static ValidationResult Success() => new() { IsValid = true };
        public static ValidationResult Failure(string message) => new() { IsValid = false, Message = message };
    }
}
